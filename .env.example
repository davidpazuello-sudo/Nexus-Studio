# ══════════════════════════════════════════════════════════
# NEXUS STUDIO — .env.example
#
# Copie este arquivo: cp .env.example .env.local
# Preencha todos os valores antes de rodar o projeto
# NUNCA commite o arquivo .env.local no GitHub
# ══════════════════════════════════════════════════════════

# ── BANCO DE DADOS ─────────────────────────────────────────
# Supabase: Settings > Database > Connection string > URI
# Troque [YOUR-PASSWORD] pela senha do seu projeto Supabase
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.XXXX.supabase.co:5432/postgres"

# ── AUTENTICAÇÃO ───────────────────────────────────────────
# Gere uma string aleatória segura:
#   openssl rand -base64 32
NEXTAUTH_SECRET="cole-aqui-string-aleatoria-de-32-caracteres"
NEXTAUTH_URL="http://localhost:3000"

# ── GOOGLE OAUTH ───────────────────────────────────────────
# Google Cloud Console > APIs e Serviços > Credenciais > Criar credencial OAuth
# URIs de redirecionamento autorizados: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="000000000000-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx"

# ── EMAILS AUTORIZADOS ─────────────────────────────────────
# Lista de emails que podem fazer login (separados por vírgula, sem espaços)
# Exemplo: "joao@gmail.com,maria@gmail.com"
ALLOWED_EMAILS="seuemail@gmail.com"

# ── INTELIGÊNCIA ARTIFICIAL ────────────────────────────────
# Anthropic (Claude) — https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# OpenAI (GPT-4o) — https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Google AI (Gemini Flash) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ── SUPABASE ───────────────────────────────────────────────
# Supabase > Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://XXXX.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.EXEMPLO"

# ── STORAGE — CLOUDFLARE R2 ────────────────────────────────
# Cloudflare Dashboard > R2 > Manage API Tokens
# O R2 usa a API compatível com S3 — configure o endpoint como:
#   https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
R2_ACCESS_KEY_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
R2_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
R2_BUCKET_NAME="nexus-studio-dev"
R2_PUBLIC_URL="https://pub-XXXX.r2.dev"
